#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
skill_source="$repo_root/skills/develop-eclab-lab"

python3 "$repo_root/scripts/develop_eclab_lab_skill.py" --repo "$repo_root" validate

configured_hooks=$(git -C "$repo_root" config --local --get core.hooksPath || true)
case "$configured_hooks" in
    ""|.githooks) ;;
    *)
        echo "error: core.hooksPath is already set to '$configured_hooks'; refusing to replace it" >&2
        exit 1
        ;;
esac

PYTHONPATH="$skill_source/src${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m develop_eclab_lab_skill.install

if [ -z "$configured_hooks" ]; then
    git -C "$repo_root" config --local core.hooksPath .githooks
fi

echo "configured repository hooks from $repo_root/.githooks"
