#!/bin/sh
set -eu
browser=""
identity=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --browser) browser=$2; shift 2 ;;
    --identity) identity=$2; shift 2 ;;
    *) echo "usage: eclab-pki-browser --browser firefox --identity REF" >&2; exit 2 ;;
  esac
done
[ "$browser" = firefox ] || { echo "only Firefox per-identity profiles are supported" >&2; exit 2; }
[ -n "$identity" ] || { echo "--identity is required" >&2; exit 2; }
profile=$(/opt/eclab-pki/runtime.py --firefox-profile "$identity")
browser_bin=$(command -v firefox || command -v firefox-esr || true)
[ -n "$browser_bin" ] || { echo "Firefox is not installed" >&2; exit 1; }
exec "$browser_bin" --profile "$profile"
